                    "style": {
                      ".": "ha-card {\n  {% if is_state('binary_sensor.short_hills_station_to_new_york_penn_station_commute_disrupted', 'on') %}\n  --njt-accent: var(--error-color);\n  {% else %}\n  --njt-accent: var(--warning-color);\n  {% endif %}\n  border: none;\n  border-left: 3px solid var(--njt-accent);\n  border-radius: 4px;\n  box-shadow: none;\n  background: color-mix(in srgb, var(--njt-accent) 8%, var(--card-background-color));\n}\n",
