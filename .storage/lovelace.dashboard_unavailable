{
  "version": 1,
  "minor_version": 1,
  "key": "lovelace.dashboard_unavailable",
  "data": {
    "config": {
      "views": [
        {
          "type": "sections",
          "sections": [
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Unavailable Shades",
                  "heading_style": "title"
                },
                {
                  "type": "custom:auto-entities",
                  "card": {
                    "type": "entities"
                  },
                  "filter": {
                    "include": [
                      {
                        "options": {},
                        "state": "unavailable",
                        "domain": "cover"
                      }
                    ],
                    "exclude": []
                  }
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "New section"
                },
                {
                  "type": "custom:auto-entities",
                  "card": {
                    "type": "history-graph"
                  },
                  "filter": {
                    "include": [
                      {
                        "options": {},
                        "entity_id": "/shade.+lqi/"
                      }
                    ],
                    "exclude": []
                  }
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "Battery problems",
                  "heading_style": "title"
                },
                {
                  "type": "custom:auto-entities",
                  "card": {
                    "type": "entities",
                    "title": "Not reporting"
                  },
                  "show_empty": false,
                  "filter": {
                    "include": [
                      {
                        "domain": "sensor",
                        "attributes": {
                          "device_class": "battery"
                        },
                        "state": "unavailable"
                      },
                      {
                        "domain": "sensor",
                        "attributes": {
                          "device_class": "battery"
                        },
                        "state": "unknown"
                      },
                      {
                        "domain": "binary_sensor",
                        "attributes": {
                          "device_class": "battery"
                        },
                        "state": "unavailable"
                      },
                      {
                        "domain": "binary_sensor",
                        "attributes": {
                          "device_class": "battery"
                        },
                        "state": "unknown"
                      }
                    ],
                    "exclude": []
                  }
                },
                {
                  "type": "custom:auto-entities",
                  "card": {
                    "type": "entities",
                    "title": "Low"
                  },
                  "show_empty": false,
                  "filter": {
                    "include": [
                      {
                        "domain": "sensor",
                        "attributes": {
                          "device_class": "battery"
                        },
                        "state": "< 20"
                      },
                      {
                        "domain": "binary_sensor",
                        "attributes": {
                          "device_class": "battery"
                        },
                        "state": "on"
                      }
                    ],
                    "exclude": []
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}